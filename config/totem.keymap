#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Media       1
#define Nav         2
#define Mouse       3
#define Sym         4
#define Num         5
#define Fun         6
#define Button      7
#define Game        8
#define Gameplus    9

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
       &kp Q  &kp W  &kp F  &kp P         &kp B             &kp J      &kp L        &kp U      &kp Y    &kp APOSTROPHE
       &kp A  &kp R  &kp S  &kp T         &kp G             &kp M      &kp N        &kp E      &kp I    &kp O
&none  &kp Z  &kp X  &kp C  &kp D         &kp V             &kp K      &kp H        &kp COMMA  &kp DOT  &kp SLASH       &none
                     &mo 3  &lt 1 ESCAPE  &kp LEFT_SHIFT    &kp SPACE  &lt 2 ENTER  &mo 4
            >;
        };

        Ext {
            label = "Ext";
            bindings = <
       &kp ESC       &kp K_BACK    &kp K_FIND  &kp K_FORWARD  &kp INSERT     &kp PAGE_UP    &kp HOME        &kp UP_ARROW    &kp END          &kp CAPS
       &sk LEFT_ALT  &sk LEFT_GUI  &sk LSHFT   &sk LCTRL      &sk RALT       &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp DELETE
&none  &kp K_UNDO    &kp K_CUT     &kp K_COPY  &kp LEFT_GUI   &kp K_PASTE    &kp ENTER      &kp BACKSPACE   &kp TAB         &kp K_MENU       &kp PRINTSCREEN  &none
                                   &none       &none          &none          &kp ENTER      &none           &none
            >;
        };

        Sym {
            label = "Sym";
            bindings = <
       &kp EXCL       &kp DOUBLE_QUOTES  &kp POUND       &kp DOLLAR  &kp PERCENT      &kp EQUAL      &kp GRAVE              &kp COLON        &kp SEMI           &kp PLUS
       &sk LEFT_ALT   &sk LEFT_GUI       &sk LEFT_SHIFT  &sk LCTRL   &kp CARET        &kp ASTERISK   &kp LEFT_PARENTHESIS   &kp LEFT_BRACE   &kp LEFT_BRACKET   &kp MINUS
&none  &kp BACKSLASH  &kp PIPE           &kp HASH        &kp TILDE   &kp AMPERSAND    &kp LS(GRAVE)  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp UNDERSCORE  &none
                                         &none           &none       &none            &none          &none                  &none
            >;
        };

        Num {
            label = "Num";
            bindings = <
       &none         &none         &none           &none          &kp KP_NUMLOCK    &kp EQUAL     &kp N7        &kp N8  &kp N9        &kp PLUS
       &sk LEFT_ALT  &sk LEFT_GUI  &sk LEFT_SHIFT  &sk LCTRL      &sk RALT          &kp ASTERISK  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp MINUS
&none  &none         &kp K_MENU    &kp TAB         &kp BACKSPACE  &kp ENTER         &kp NUMBER_0  &kp N1        &kp N2  &kp N3        &kp SLASH  &none
                                   &none           &none          &none             &none         &none         &none
            >;
        };

        Fn {
            bindings = <
       &none         &none         &none           &none      &none            &kp F12    &kp F7  &kp F8  &kp F9  &none
       &sk LEFT_ALT  &sk LEFT_GUI  &sk LEFT_SHIFT  &sk LCTRL  &sk RIGHT_ALT    &kp F11    &kp F4  &kp F5  &kp F6  &none
&none  &none         &none         &kp K_COPY      &none      &kp K_PASTE      &kp F10    &kp F1  &kp F2  &kp F3  &none  &none
                                   &none           &none      &none            &kp ENTER  &none   &none
            >;
        };
    };
};
